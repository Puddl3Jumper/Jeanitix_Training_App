<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JeanetixMAUI.Pages.HistoryPage"
             BackgroundColor="#1A1A1A"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,Auto,Auto,*" BackgroundColor="#1A1A1A">
        <!-- Title -->
        <Label Grid.Row="0" Text="Workout History" FontSize="24" FontAttributes="Bold" TextColor="White"
               Margin="20,56,20,0"/>

        <!-- Range tabs -->
        <Border Grid.Row="1" BackgroundColor="#24242C" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                Margin="20,16,20,0" Padding="6">
            <HorizontalStackLayout Spacing="6">
                <Border x:Name="DayTabBorder" BackgroundColor="#D4AF37" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="16,8">
                    <Label x:Name="DayTab" Text="Today" TextColor="#1F1600" FontSize="13" FontAttributes="Bold"/>
                </Border>
                <Border x:Name="WeekTabBorder" BackgroundColor="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="16,8">
                    <Label x:Name="WeekTab" Text="Week" TextColor="#9CA3AF" FontSize="13"/>
                </Border>
                <Border x:Name="MonthTabBorder" BackgroundColor="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="16,8">
                    <Label x:Name="MonthTab" Text="Month" TextColor="#9CA3AF" FontSize="13"/>
                </Border>
            </HorizontalStackLayout>
        </Border>

        <!-- Range Label -->
        <Label x:Name="RangeLabel" Grid.Row="2" Text="Today" FontSize="12" TextColor="#6B7280"
               Margin="20,12,20,0"/>

        <!-- History List -->
        <ScrollView Grid.Row="3">
            <VerticalStackLayout x:Name="HistoryContainer" Padding="20,8,20,80" Spacing="12">
                <Label x:Name="EmptyLabel" Text="No workouts in this period." FontSize="14"
                       TextColor="#6B7280" HorizontalOptions="Center" Margin="0,32" IsVisible="False"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
