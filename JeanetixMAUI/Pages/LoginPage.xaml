<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JeanetixMAUI.Pages.LoginPage"
             BackgroundColor="#1A1A1A"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="32,60,32,40" Spacing="0">

            <!-- Logo / Title -->
            <Image Source="appicon.png" HeightRequest="80" WidthRequest="80"
                   HorizontalOptions="Center" Margin="0,0,0,16"/>
            <Label Text="Jeanetx Fitness" FontSize="28" FontAttributes="Bold"
                   TextColor="White" HorizontalOptions="Center"/>
            <Label Text="Your gym journal" FontSize="14" TextColor="#9CA3AF"
                   HorizontalOptions="Center" Margin="0,4,0,40"/>

            <!-- Email -->
            <Label Text="Email" TextColor="#9CA3AF" FontSize="13" Margin="0,0,0,6"/>
            <Entry x:Name="EmailEntry" Placeholder="your@email.com" PlaceholderColor="#6B7280"
                   BackgroundColor="#24242C" Keyboard="Email"
                   ReturnType="Next" HeightRequest="48"
                   Margin="0,0,0,16"/>

            <!-- Password -->
            <Label Text="Password" TextColor="#E0E0E0" FontSize="13" Margin="0,0,0,6"/>
            <Entry x:Name="PasswordEntry" Placeholder="Password" PlaceholderColor="#9E9E9E"
                   TextColor="White" BackgroundColor="#24242C" IsPassword="True"
                   ReturnType="Done" HeightRequest="48"
                   Margin="0,0,0,28"/>

            <!-- Sign In Button -->
            <Button x:Name="SignInButton" Text="Sign In" BackgroundColor="#D4AF37"
                    TextColor="#1F1600" FontAttributes="Bold" FontSize="16"
                    CornerRadius="12" HeightRequest="52" Margin="0,0,0,16"
                    Clicked="OnSignInClicked"/>

            <!-- Divider -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="12" Margin="0,0,0,16">
                <BoxView Color="#374151" WidthRequest="80" HeightRequest="1" VerticalOptions="Center"/>
                <Label Text="or" TextColor="#6B7280" FontSize="13"/>
                <BoxView Color="#374151" WidthRequest="80" HeightRequest="1" VerticalOptions="Center"/>
            </HorizontalStackLayout>

            <!-- Create Account -->
            <Button Text="Create Account" BackgroundColor="#24242C" TextColor="#D4AF37"
                    BorderColor="#D4AF37" BorderWidth="1.5"
                    FontAttributes="Bold" FontSize="16" CornerRadius="12" HeightRequest="52"
                    Clicked="OnCreateAccountClicked"/>

            <!-- Skip for now -->
            <Button Text="Continue as Guest" BackgroundColor="Transparent" TextColor="#9E9E9E"
                    FontSize="14" Margin="0,16,0,0" Clicked="OnGuestClicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
