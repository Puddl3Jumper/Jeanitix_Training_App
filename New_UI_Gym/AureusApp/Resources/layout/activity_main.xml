<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="@color/surface">

        <LinearLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_profile_circle">

            <TextView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:gravity="center"
                android:text="•"
                android:textColor="@color/on_surface"
                android:textStyle="bold"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:gravity="center"
            android:text="AUREUS ATHLETIC"
            android:textColor="@color/primary_container"
            android:textStyle="bold"
            android:textSize="20sp"
            android:letterSpacing="0.08"
            android:fontFamily="sans-serif-condensed" />

        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="◉"
            android:textColor="@color/primary_container"
            android:textStyle="bold"
            android:textSize="16sp"
            android:background="@drawable/bg_icon_pill" />
    </LinearLayout>

    <View
        android:id="@+id/topDivider"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_below="@id/topBar"
        android:background="@color/surface_container_low" />

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp"
        android:background="@drawable/bg_bottom_nav">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_nav_item">

            <TextView
                android:id="@+id/navIconHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌂"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/nav_inactive" />

            <TextView
                android:id="@+id/navLabelHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HOME"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/nav_inactive" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navWorkouts"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_nav_item">

            <TextView
                android:id="@+id/navIconWorkouts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▣"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/nav_inactive" />

            <TextView
                android:id="@+id/navLabelWorkouts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WORKOUTS"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/nav_inactive" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navTrain"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_nav_selected">

            <TextView
                android:id="@+id/navIconTrain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✎"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/on_primary" />

            <TextView
                android:id="@+id/navLabelTrain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TRAIN"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/on_primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_nav_item">

            <TextView
                android:id="@+id/navIconProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/nav_inactive" />

            <TextView
                android:id="@+id/navLabelProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PROFILE"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/nav_inactive" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topDivider"
        android:layout_above="@id/bottomNav"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TRAINING LOG"
                android:textColor="@color/primary"
                android:textStyle="bold"
                android:textSize="44sp"
                android:lineSpacingExtra="-5dp"
                android:fontFamily="sans-serif-condensed" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/dayMon"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_day_unselected">

                        <TextView
                            android:id="@+id/dayLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MON"
                            android:textColor="#68D0C5AF"
                            android:textStyle="bold"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/dayNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="18"
                            android:textColor="#68E5E2E1"
                            android:textStyle="bold"
                            android:textSize="20sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/dayTue"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_day_unselected">

                        <TextView
                            android:id="@id/dayLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TUE"
                            android:textColor="#68D0C5AF"
                            android:textStyle="bold"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@id/dayNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="19"
                            android:textColor="#68E5E2E1"
                            android:textStyle="bold"
                            android:textSize="20sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/dayToday"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_day_selected">

                        <TextView
                            android:id="@id/dayLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TODAY"
                            android:textColor="@color/on_primary"
                            android:textStyle="bold"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@id/dayNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="20"
                            android:textColor="@color/on_primary"
                            android:textStyle="bold"
                            android:textSize="22sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/dayThu"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_day_unselected">

                        <TextView
                            android:id="@id/dayLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="THU"
                            android:textColor="#68D0C5AF"
                            android:textStyle="bold"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@id/dayNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="21"
                            android:textColor="#68E5E2E1"
                            android:textStyle="bold"
                            android:textSize="20sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/dayFri"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_day_unselected">

                        <TextView
                            android:id="@id/dayLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FRI"
                            android:textColor="#68D0C5AF"
                            android:textStyle="bold"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@id/dayNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="22"
                            android:textColor="#68E5E2E1"
                            android:textStyle="bold"
                            android:textSize="20sp" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/exerciseListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <Button
                android:id="@+id/finishWorkoutButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="30dp"
                android:text="FINISH WORKOUT"
                android:textColor="@color/on_primary"
                android:textStyle="bold"
                android:textSize="12sp"
                android:letterSpacing="0.25"
                android:background="@drawable/bg_finish_workout" />

            <TextView
                android:id="@+id/workoutDurationLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="WORKOUT DURATION: 42M 15S"
                android:textColor="#7FD0C5AF"
                android:textStyle="bold"
                android:textSize="10sp" />
        </LinearLayout>
    </ScrollView>

</RelativeLayout>
