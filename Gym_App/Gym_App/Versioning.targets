<Project>
  <UsingTask
    TaskName="GymAppVersionTask"
    TaskFactory="RoslynCodeTaskFactory"
    AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <VersionFile ParameterType="System.String" Required="true" />
      <DisplayVersion ParameterType="System.String" Output="true" />
      <VersionCode ParameterType="System.Int32" Output="true" />
    </ParameterGroup>
    <Task>
      <Reference Include="System.Globalization" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var utc = DateTime.UtcNow;
        var major = utc.Year;
        var minor = ISOWeek.GetWeekOfYear(utc);
        var stamp = $"{major}.{minor}";

        var path = VersionFile;
        var directory = Path.GetDirectoryName(path);
        if (!string.IsNullOrEmpty(directory))
        {
          Directory.CreateDirectory(directory);
        }

        var patch = 0;
        if (File.Exists(path))
        {
          var lines = File.ReadAllLines(path);
          if (lines.Length >= 2
              && string.Equals(lines[0].Trim(), stamp, StringComparison.Ordinal)
              && int.TryParse(lines[1].Trim(), out var storedPatch))
          {
            patch = storedPatch;
          }
        }

        patch++;
        File.WriteAllLines(path, new[] { stamp, patch.ToString() });

        DisplayVersion = $"{major}.{minor}.{patch}";
        VersionCode = (major * 1000000) + (minor * 10000) + patch;
      ]]></Code>
    </Task>
  </UsingTask>

  <Target
    Name="_IncrementAndroidVersion"
    BeforeTargets="PrepareForBuild"
    Condition="'$(DesignTimeBuild)' != 'true'">
    <GymAppVersionTask VersionFile="$(VersionFile)">
      <Output TaskParameter="DisplayVersion" PropertyName="ApplicationDisplayVersion" />
      <Output TaskParameter="VersionCode" PropertyName="ApplicationVersion" />
    </GymAppVersionTask>

    <PropertyGroup Condition="'$(GITHUB_RUN_NUMBER)' != ''">
      <ApplicationVersion>$(GITHUB_RUN_NUMBER)</ApplicationVersion>
    </PropertyGroup>
  </Target>
</Project>
