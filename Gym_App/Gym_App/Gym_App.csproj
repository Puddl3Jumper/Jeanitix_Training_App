<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.leiyu.GymJournal</ApplicationId>
    <ApplicationDisplayVersion>2026.17.0</ApplicationDisplayVersion>
    <AndroidManifest>AndroidManifest.xml</AndroidManifest>
    <AndroidEnableMultiDex>true</AndroidEnableMultiDex>
    <AndroidUseAapt2Daemon>false</AndroidUseAapt2Daemon>
    <AndroidAapt2CompileExtraArgs>--no-crunch</AndroidAapt2CompileExtraArgs>
    <AndroidUseIntermediateDesignerFile>true</AndroidUseIntermediateDesignerFile>
    <TrimMode>copy</TrimMode>
    <Platforms>AnyCPU;ARM64</Platforms>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishTrimmed>false</PublishTrimmed>
    <TrimMode>copy</TrimMode>
    <AndroidLinkMode>None</AndroidLinkMode>
    <AndroidUseManagedCodeTrampolines>false</AndroidUseManagedCodeTrampolines>
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
    <RunAOTCompilation>false</RunAOTCompilation>

            <!-- Standard Android approach: monotonic CI build number when available. -->
            <ApplicationVersion Condition="'$(GITHUB_RUN_NUMBER)' != ''">$(GITHUB_RUN_NUMBER)</ApplicationVersion>
              <!-- Local fallback: compact monotonic value (yy + day-of-year + hour), e.g. 2609107. -->
              <ApplicationVersion Condition="'$(GITHUB_RUN_NUMBER)' == ''">$([System.DateTime]::UtcNow.ToString("yy"))$([System.DateTime]::UtcNow.DayOfYear.ToString("D3"))$([System.DateTime]::UtcNow.ToString("HH"))</ApplicationVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <ApplicationVersion>2</ApplicationVersion>
    <AndroidFastDeploymentType>None</AndroidFastDeploymentType>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Xamarin.Google.Android.Material" Version="1.12.0.2" />
    <PackageReference Include="Xamarin.GooglePlayServices.Auth" Version="119.0.0" />
  </ItemGroup>

  <ItemGroup>
    <GoogleServicesJson Include="google-services.json" />
  </ItemGroup>

  <ItemGroup>
    <AndroidAsset Include="google-services.json" />
  </ItemGroup>
</Project>