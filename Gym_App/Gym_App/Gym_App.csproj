<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.leiyu.GymJournal</ApplicationId>
    <!-- Tesla-style semver: major.minor.patch (e.g. 4.57.0) -->
    <VersionMajor>1</VersionMajor>
    <VersionMinor>0</VersionMinor>
    <ApplicationDisplayVersion>$(VersionMajor).$(VersionMinor).0</ApplicationDisplayVersion>
    <VersionFile>$(MSBuildProjectDirectory)\build.version</VersionFile>
    <AndroidManifest>AndroidManifest.xml</AndroidManifest>
    <AndroidEnableMultiDex>true</AndroidEnableMultiDex>
    <AndroidUseAapt2Daemon>false</AndroidUseAapt2Daemon>
    <AndroidAapt2CompileExtraArgs>--no-crunch</AndroidAapt2CompileExtraArgs>
    <AndroidUseIntermediateDesignerFile>true</AndroidUseIntermediateDesignerFile>
    <TrimMode>copy</TrimMode>
    <Platforms>AnyCPU;ARM64</Platforms>
  </PropertyGroup>

  <!-- Bump versionCode + visible version on every real build (not design-time). -->
  <Target Name="_IncrementAndroidVersion" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <ReadLinesFromFile File="$(VersionFile)" Condition="Exists('$(VersionFile)')">
      <Output TaskParameter="Lines" PropertyName="_VersionFileLine" />
    </ReadLinesFromFile>

    <PropertyGroup>
      <_StoredPatch>$([MSBuild]::ValueOrDefault($(_VersionFileLine), 0))</_StoredPatch>
      <VersionPatch>$([MSBuild]::Add($(_StoredPatch), 1))</VersionPatch>
      <ApplicationDisplayVersion>$(VersionMajor).$(VersionMinor).$(VersionPatch)</ApplicationDisplayVersion>
      <ApplicationVersion>$([MSBuild]::Add($([MSBuild]::Multiply($([MSBuild]::Add($([MSBuild]::Multiply($(VersionMajor), 1000)), $(VersionMinor))), 100)), $(VersionPatch)))</ApplicationVersion>
    </PropertyGroup>

    <PropertyGroup Condition="'$(GITHUB_RUN_NUMBER)' != ''">
      <ApplicationVersion>$(GITHUB_RUN_NUMBER)</ApplicationVersion>
    </PropertyGroup>

    <WriteLinesToFile
      File="$(VersionFile)"
      Lines="$(VersionPatch)"
      Overwrite="true" />
  </Target>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishTrimmed>false</PublishTrimmed>
    <TrimMode>copy</TrimMode>
    <AndroidLinkMode>None</AndroidLinkMode>
    <AndroidUseManagedCodeTrampolines>false</AndroidUseManagedCodeTrampolines>
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
    <RunAOTCompilation>false</RunAOTCompilation>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <AndroidFastDeploymentType>None</AndroidFastDeploymentType>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Xamarin.Google.Android.Material" Version="1.12.0.2" />
    <PackageReference Include="Xamarin.GooglePlayServices.Auth" Version="119.0.0" />
  </ItemGroup>

  <ItemGroup>
    <GoogleServicesJson Include="google-services.json" />
  </ItemGroup>

  <ItemGroup>
    <AndroidAsset Include="google-services.json" />
  </ItemGroup>
</Project>