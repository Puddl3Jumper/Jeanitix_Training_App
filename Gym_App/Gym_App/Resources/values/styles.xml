<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="Theme.GymApp" parent="Theme.Material3.Dark.NoActionBar">
    <item name="colorPrimary">@color/md_theme_primary</item>
    <item name="colorOnPrimary">@color/md_theme_onPrimary</item>
    <item name="colorPrimaryContainer">@color/md_theme_primaryContainer</item>
    <item name="colorOnPrimaryContainer">@color/md_theme_onPrimaryContainer</item>
    <item name="colorSecondary">@color/md_theme_secondary</item>
    <item name="colorOnSecondary">@color/md_theme_onSecondary</item>
    <item name="colorSecondaryContainer">@color/md_theme_secondaryContainer</item>
    <item name="colorOnSecondaryContainer">@color/md_theme_onSecondaryContainer</item>
    <item name="colorOnBackground">@color/md_theme_onBackground</item>
    <item name="colorSurface">@color/md_theme_surface</item>
    <item name="colorOnSurface">@color/md_theme_onSurface</item>
    <item name="colorSurfaceVariant">@color/md_theme_surfaceVariant</item>
    <item name="colorOnSurfaceVariant">@color/md_theme_onSurfaceVariant</item>
    <item name="colorOutline">@color/md_theme_outline</item>
    <item name="android:colorBackground">@color/md_theme_background</item>
    <item name="android:windowBackground">@color/md_theme_background</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@color/bottom_nav_bg</item>
    <item name="android:textViewStyle">@style/Widget.GymApp.TextView</item>
    <item name="android:editTextStyle">@style/Widget.GymApp.EditText</item>
    <item name="android:buttonStyle">@style/Widget.GymApp.Button</item>
    <item name="materialAlertDialogTheme">@style/ThemeOverlay.GymApp.MaterialAlertDialog</item>
    <item name="materialButtonStyle">@style/Widget.GymApp.Button</item>
  </style>

  <style name="Theme.GymApp.Serif" parent="Theme.GymApp">
    <item name="android:fontFamily">serif</item>
    <item name="fontFamily">serif</item>
  </style>

  <style name="Theme.GymApp.Mono" parent="Theme.GymApp">
    <item name="android:fontFamily">monospace</item>
    <item name="fontFamily">monospace</item>
  </style>

  <style name="Theme.GymApp.Light" parent="Theme.Material3.Light.NoActionBar">
    <item name="colorPrimary">@color/md_theme_light_primary</item>
    <item name="colorOnPrimary">@color/md_theme_light_onPrimary</item>
    <item name="colorPrimaryContainer">@color/md_theme_light_primaryContainer</item>
    <item name="colorOnPrimaryContainer">@color/md_theme_light_onPrimaryContainer</item>
    <item name="colorSecondary">@color/md_theme_light_secondary</item>
    <item name="colorOnSecondary">@color/md_theme_light_onSecondary</item>
    <item name="colorSecondaryContainer">@color/md_theme_light_secondaryContainer</item>
    <item name="colorOnSecondaryContainer">@color/md_theme_light_onSecondaryContainer</item>
    <item name="colorOnBackground">@color/md_theme_light_onBackground</item>
    <item name="colorSurface">@color/md_theme_light_surface</item>
    <item name="colorOnSurface">@color/md_theme_light_onSurface</item>
    <item name="colorSurfaceVariant">@color/md_theme_light_surfaceVariant</item>
    <item name="colorOnSurfaceVariant">@color/md_theme_light_onSurfaceVariant</item>
    <item name="colorOutline">@color/md_theme_light_outline</item>
    <item name="android:colorBackground">@color/md_theme_light_background</item>
    <item name="android:windowBackground">@color/md_theme_light_background</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@color/bottom_nav_bg</item>
    <item name="android:textViewStyle">@style/Widget.GymApp.TextView</item>
    <item name="android:editTextStyle">@style/Widget.GymApp.EditText</item>
    <item name="android:buttonStyle">@style/Widget.GymApp.Button</item>
    <item name="materialAlertDialogTheme">@style/ThemeOverlay.GymApp.MaterialAlertDialog</item>
    <item name="materialButtonStyle">@style/Widget.GymApp.Button</item>
  </style>

  <style name="Theme.GymApp.Light.Serif" parent="Theme.GymApp.Light">
    <item name="android:fontFamily">serif</item>
    <item name="fontFamily">serif</item>
  </style>

  <style name="Theme.GymApp.Light.Mono" parent="Theme.GymApp.Light">
    <item name="android:fontFamily">monospace</item>
    <item name="fontFamily">monospace</item>
  </style>

  <style name="ThemeOverlay.GymApp.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog" />

  <style name="Widget.GymApp.TextView" parent="@android:style/Widget.TextView">
    <item name="android:textSize">@dimen/gym_text_size_body</item>
    <item name="android:textStyle">normal</item>
    <item name="android:fontFamily">sans-serif</item>
    <item name="android:textColor">@color/color_text_primary</item>
  </style>

  <style name="Widget.GymApp.EditText" parent="@android:style/Widget.EditText">
    <item name="android:textSize">@dimen/gym_text_size_body</item>
    <item name="android:textStyle">normal</item>
    <item name="android:fontFamily">sans-serif</item>
  </style>

  <style name="Widget.GymApp.Button" parent="Widget.Material3.Button">
    <item name="android:insetLeft">0dp</item>
    <item name="android:insetRight">0dp</item>
    <item name="android:insetTop">0dp</item>
    <item name="android:insetBottom">0dp</item>
    <item name="android:minHeight">@dimen/gym_primary_button_height</item>
    <item name="cornerRadius">@dimen/gym_pill_corner_radius</item>
    <item name="android:background">@drawable/bg_button_primary</item>
    <item name="android:textColor">@android:color/black</item>
    <item name="android:textSize">@dimen/gym_text_size_button</item>
    <item name="android:textStyle">bold</item>
    <item name="android:fontFamily">sans-serif-medium</item>
    <item name="android:elevation">4dp</item>
    <item name="android:stateListAnimator">@animator/edit_button_elevation</item>
  </style>

  <style name="Widget.GymApp.TextInputLayout" parent="Widget.Material3.TextInputLayout.FilledBox">
    <item name="boxBackgroundColor">@color/md_theme_surfaceVariant</item>
    <item name="boxStrokeColor">@color/md_theme_outline</item>
    <item name="boxStrokeWidth">0dp</item>
    <item name="boxStrokeWidthFocused">0dp</item>
    <item name="hintTextColor">@color/md_theme_onSurfaceVariant</item>
    <item name="boxCornerRadiusTopStart">16dp</item>
    <item name="boxCornerRadiusTopEnd">16dp</item>
    <item name="boxCornerRadiusBottomStart">16dp</item>
    <item name="boxCornerRadiusBottomEnd">16dp</item>
  </style>

  <style name="TextAppearance.GymApp.Toolbar.Small" parent="TextAppearance.Material3.TitleLarge">
    <item name="android:textSize">16sp</item>
    <item name="android:textColor">@color/color_text_secondary</item>
  </style>

  <style name="TextAppearance.GymApp.TopAppBarTitle" parent="TextAppearance.Material3.TitleLarge">
    <item name="android:textStyle">bold</item>
  </style>

  <style name="Widget.GymApp.TopAppBar" parent="Widget.Material3.Toolbar">
    <item name="android:backgroundTint">?attr/colorSurfaceVariant</item>
    <item name="titleTextAppearance">@style/TextAppearance.GymApp.TopAppBarTitle</item>
    <item name="titleTextColor">?attr/colorOnSurface</item>
  </style>
</resources>
