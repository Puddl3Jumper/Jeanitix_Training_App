<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <gradient
        android:startColor="#FFF7D54A"
        android:centerColor="#FFF3C716"
        android:endColor="#FFE4B800"
        android:angle="270" />
      <corners android:radius="24dp" />
      <stroke android:width="1dp" android:color="#FFFCE794" />
    </shape>
  </item>
  <item android:top="1dp" android:left="1dp" android:right="1dp">
    <shape android:shape="rectangle">
      <gradient
        android:startColor="#88FFFFFF"
        android:endColor="#00FFFFFF"
        android:angle="270" />
      <corners android:radius="23dp" />
    </shape>
  </item>
</layer-list>
