<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Bottom-only shadow (transparent → shadow) for a raised 3D look -->
  <item android:left="4dp" android:top="12dp" android:right="4dp" android:bottom="0dp">
    <shape android:shape="rectangle">
      <gradient
          android:angle="90"
          android:startColor="@android:color/transparent"
          android:endColor="@color/edit_button_shadow" />
      <corners android:radius="@dimen/gym_edit_button_corner_radius" />
    </shape>
  </item>

  <!-- Base pill gradient (pressed) -->
  <item android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="4dp">
    <shape android:shape="rectangle">
      <gradient
          android:angle="0"
          android:startColor="@color/edit_button_grad_start_pressed"
          android:endColor="@color/edit_button_grad_end_pressed" />
      <corners android:radius="@dimen/gym_edit_button_corner_radius" />
    </shape>
  </item>

  <item android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="4dp">
    <shape android:shape="rectangle">
      <gradient
          android:angle="270"
          android:startColor="@color/edit_button_highlight"
          android:endColor="@android:color/transparent" />
      <corners android:radius="@dimen/gym_edit_button_corner_radius" />
    </shape>
  </item>

  <item android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="4dp">
    <shape android:shape="rectangle">
      <gradient
          android:angle="90"
          android:startColor="@android:color/transparent"
          android:endColor="@color/edit_button_shade" />
      <corners android:radius="@dimen/gym_edit_button_corner_radius" />
    </shape>
  </item>
</layer-list>
