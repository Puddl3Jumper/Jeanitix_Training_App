<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Base: surface with outline -->
  <item>
    <shape android:shape="rectangle">
      <gradient
          android:angle="90"
          android:startColor="@color/md_theme_surfaceVariant"
          android:endColor="@color/md_theme_surface" />
      <corners android:radius="16dp" />
      <stroke android:width="1dp" android:color="@color/md_theme_outline" />
    </shape>
  </item>

  <!-- Soft primary blob (top-left) -->
  <item android:left="-26dp" android:top="-34dp" android:alpha="0.18">
    <shape android:shape="oval">
      <size android:width="160dp" android:height="160dp" />
      <solid android:color="@color/color_primary" />
    </shape>
  </item>

  <!-- Soft primary blob (bottom-right) -->
  <item android:right="-34dp" android:bottom="-44dp" android:alpha="0.14">
    <shape android:shape="oval">
      <size android:width="200dp" android:height="200dp" />
      <solid android:color="@color/color_primary" />
    </shape>
  </item>

  <!-- Center icon -->
  <item android:gravity="center" android:alpha="0.95" android:drawable="@drawable/ic_motivation_medal" />

</layer-list>
