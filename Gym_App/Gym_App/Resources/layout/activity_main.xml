<?xml version="1.0" encoding="utf-8"?>
<Gym_App.Views.InsetsAwareWelcomeRoot xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/welcomeRoot"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="0dp"
    android:paddingBottom="0dp"
    android:background="@drawable/bg_screen"
    android:clipToPadding="false">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:background="@drawable/bg_screen"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/welcomeHeroImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="220dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="6dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/welcome_hero" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:text="@string/main_hero_headline"
                android:textColor="@color/color_primary"
                android:textSize="40sp"
                android:textStyle="bold"
                android:maxLines="3"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="26sp"
                android:autoSizeMaxTextSize="44sp"
                android:autoSizeStepGranularity="1sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/main_subtitle"
                android:textSize="15sp"
                android:textStyle="italic"
                android:textColor="@color/color_text_secondary"
                android:gravity="center"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/main_subtitle_author"
                android:textSize="13sp"
                android:textColor="@color/color_text_secondary"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/launch_copyright"
                android:textSize="13sp"
                android:textColor="@color/color_text_secondary"
                android:gravity="center"
                android:layout_marginBottom="12dp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/welcomeBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_screen"
        android:paddingTop="8dp"
        android:paddingBottom="@dimen/welcome_screen_bottom_base">

        <Button
            android:id="@+id/startWorkoutMainButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/start_workout"
            android:textSize="20sp"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@color/color_on_primary"
            android:background="@drawable/bg_button_primary"
            android:stateListAnimator="@animator/edit_button_elevation"
            android:elevation="4dp"
            android:fontFamily="sans-serif-medium"
            android:drawableStart="@drawable/ic_m3_play_arrow"
            android:drawablePadding="10dp"
            android:gravity="center_vertical|center"
            android:minHeight="@dimen/gym_primary_button_height"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/continueWorkoutMainButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/continue_workout"
            android:textSize="18sp"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@color/color_on_primary"
            android:background="@drawable/bg_button_primary"
            android:stateListAnimator="@animator/edit_button_elevation"
            android:elevation="4dp"
            android:fontFamily="sans-serif-medium"
            android:drawableStart="@drawable/ic_m3_person"
            android:drawablePadding="10dp"
            android:gravity="center_vertical|center"
            android:minHeight="@dimen/gym_primary_button_height"
            android:paddingStart="18dp"
            android:paddingEnd="18dp" />
    </LinearLayout>

</Gym_App.Views.InsetsAwareWelcomeRoot>
