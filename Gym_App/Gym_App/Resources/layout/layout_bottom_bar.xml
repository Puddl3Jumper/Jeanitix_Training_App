<?xml version="1.0" encoding="utf-8"?>
<Gym_App.Views.InsetsAwareBottomBar xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="66dp"
    android:layout_marginBottom="0dp"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:clipToPadding="false"
    android:clipChildren="false"
    android:weightSum="4"
    android:gravity="center"
    android:background="@drawable/bg_tabbar"
    android:paddingStart="0dp"
    android:paddingEnd="0dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/homeTab"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:baselineAligned="false"
        android:gravity="center"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:paddingTop="3dp"
        android:paddingBottom="0dp">
        <LinearLayout
            android:layout_width="48dp"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_bottom_tab_selector"
            android:duplicateParentState="true">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_home"
                android:tint="@color/bottom_tab_icon_selector"
                android:duplicateParentState="true" />
        </LinearLayout>
        <TextView
            android:id="@+id/homeTabLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Home"
            android:textColor="@color/bottom_tab_text_selector"
            android:textSize="14sp"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:duplicateParentState="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/diaryTab"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:baselineAligned="false"
        android:gravity="center"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:paddingTop="3dp"
        android:paddingBottom="0dp">
        <LinearLayout
            android:layout_width="48dp"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_bottom_tab_selector"
            android:duplicateParentState="true">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_diary"
                android:tint="@color/bottom_tab_icon_selector"
                android:duplicateParentState="true" />
        </LinearLayout>
        <TextView
            android:id="@+id/diaryTabLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Log"
            android:textColor="@color/bottom_tab_text_selector"
            android:textSize="14sp"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:duplicateParentState="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/workoutTab"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:baselineAligned="false"
        android:gravity="center"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:paddingTop="3dp"
        android:paddingBottom="0dp">
        <LinearLayout
            android:layout_width="48dp"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_bottom_tab_selector"
            android:duplicateParentState="true">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_workout"
                android:tint="@color/bottom_tab_icon_selector"
                android:duplicateParentState="true" />
        </LinearLayout>
        <TextView
            android:id="@+id/workoutTabLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Train"
            android:textColor="@color/bottom_tab_text_selector"
            android:textSize="14sp"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:duplicateParentState="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/profileTab"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:baselineAligned="false"
        android:gravity="center"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:paddingTop="3dp"
        android:paddingBottom="0dp">
        <LinearLayout
            android:layout_width="48dp"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_bottom_tab_selector"
            android:duplicateParentState="true">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_nav_profile"
                android:tint="@color/bottom_tab_icon_selector"
                android:duplicateParentState="true" />
        </LinearLayout>
        <TextView
            android:id="@+id/profileTabLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Me"
            android:textColor="@color/bottom_tab_text_selector"
            android:textSize="14sp"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:duplicateParentState="true" />
    </LinearLayout>

</Gym_App.Views.InsetsAwareBottomBar>
