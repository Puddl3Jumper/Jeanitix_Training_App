<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="108dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Training"
                        android:textColor="@color/home_cta_orange"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/trainingHistoryButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_log_tab_inactive"
                        android:src="@drawable/ic_history_outline"
                        android:tint="@color/color_text_primary"
                        android:contentDescription="History"
                        android:padding="10dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_today_outer"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/focusValueText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Workout Focus"
                        android:textColor="@color/color_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:id="@+id/muscleBar1LabelText"
                            android:layout_width="72dp"
                            android:layout_height="wrap_content"
                            android:text="Chest"
                            android:textColor="@color/color_text_secondary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="9dp"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_log_tab_inactive"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp">
                            <View
                                android:id="@+id/chestBarFill"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="10"
                                android:background="@color/color_primary" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/chestBarTimeText"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:text="25m"
                            android:textColor="@color/color_text_primary"
                            android:textStyle="bold"
                            android:gravity="end" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:id="@+id/muscleBar2LabelText"
                            android:layout_width="72dp"
                            android:layout_height="wrap_content"
                            android:text="Triceps"
                            android:textColor="@color/color_text_secondary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="9dp"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_log_tab_inactive"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp">
                            <View
                                android:id="@+id/tricepsBarFill"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="4"
                                android:background="@color/color_primary" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tricepsBarTimeText"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:text="10m"
                            android:textColor="@color/color_text_primary"
                            android:textStyle="bold"
                            android:gravity="end" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/muscleBar3LabelText"
                            android:layout_width="72dp"
                            android:layout_height="wrap_content"
                            android:text="Shoulders"
                            android:textColor="@color/color_text_secondary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="9dp"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_log_tab_inactive"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp">
                            <View
                                android:id="@+id/shouldersBarFill"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="2"
                                android:background="@color/color_primary" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/shouldersBarTimeText"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:text="7m"
                            android:textColor="@color/color_text_primary"
                            android:textStyle="bold"
                            android:gravity="end" />
                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_today_outer"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:id="@+id/currentExerciseNameText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Workout Groups"
                            android:textColor="@color/color_text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/currentElapsedTimeText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Elapsed Time: 12:35"
                            android:textColor="@color/color_primary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:gravity="end" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_log_tab_inactive"
                        android:paddingStart="14dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/set1RepsText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Circuit A: waiting for contents"
                            android:textColor="@color/color_text_primary"
                            android:textSize="14sp"
                            android:maxLines="2"
                            android:ellipsize="end" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="@color/color_text_secondary"
                            android:textStyle="bold"
                            android:textSize="24sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_log_tab_inactive"
                        android:paddingStart="14dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/set2RepsText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Circuit B: waiting for contents"
                            android:textColor="@color/color_text_primary"
                            android:textSize="14sp"
                            android:maxLines="2"
                            android:ellipsize="end" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="@color/color_text_secondary"
                            android:textStyle="bold"
                            android:textSize="24sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_log_tab_inactive"
                        android:paddingStart="14dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:id="@+id/set3RepsText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Circuit C: waiting for contents"
                            android:textColor="@color/color_text_primary"
                            android:textSize="14sp"
                            android:maxLines="2"
                            android:ellipsize="end" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="@color/color_text_secondary"
                            android:textStyle="bold"
                            android:textSize="24sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/startTimerButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="@dimen/gym_primary_button_height"
                            android:text="Start Timer"
                            android:textAllCaps="false"
                            android:textStyle="bold"
                            android:textColor="@color/color_on_primary"
                            android:background="@drawable/bg_button_primary"
                            android:layout_marginEnd="8dp" />

                        <Button
                            android:id="@+id/finishWorkoutButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="@dimen/gym_primary_button_height"
                            android:text="Finish"
                            android:textAllCaps="false"
                            android:textStyle="bold"
                            android:textColor="@color/color_on_primary"
                            android:background="@drawable/bg_button_train_action" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/logExerciseFab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            android:text="Log Exercise"
            android:textStyle="bold"
            app:icon="@drawable/ic_fitness_center"
            app:iconTint="@color/color_on_primary"
            android:textColor="@color/color_on_primary"
            android:backgroundTint="@color/color_primary" />
    </FrameLayout>

    <include layout="@layout/layout_bottom_bar" />

</LinearLayout>
