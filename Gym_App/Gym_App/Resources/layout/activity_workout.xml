<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="108dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Training"
                        android:textColor="@color/home_cta_orange"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/trainingHistoryButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_log_tab_inactive"
                        android:src="@drawable/ic_history_outline"
                        android:tint="@color/color_text_primary"
                        android:contentDescription="History"
                        android:padding="10dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_today_outer"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/workout_duration_label"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="14sp"
                        android:layout_marginBottom="6dp" />

                    <Chronometer
                        android:id="@+id/workoutDurationChronometer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/workout_timer_default"
                        android:textColor="@color/color_primary"
                        android:textSize="36sp"
                        android:textStyle="bold"
                        android:format="%s" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_today_outer"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="match_parent"
                            android:background="@color/home_cta_orange"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/focusValueText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Upper Body"
                            android:textColor="@color/color_text_primary"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/upperBodyCardImage"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:src="@drawable/chest_focus"
                        android:scaleType="centerCrop"
                        android:contentDescription="Upper Body Focus Image"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="4dp">

                        <TextView
                            android:id="@+id/upperBodyWorkout1Text"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_card_m3_elevated"
                            android:gravity="center_vertical"
                            android:paddingStart="16dp"
                            android:text="Barbell Bench Press"
                            android:textColor="@color/color_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/upperBodyWorkout2Text"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_card_m3_elevated"
                            android:gravity="center_vertical"
                            android:paddingStart="16dp"
                            android:text="Weighted Pull-Ups"
                            android:textColor="@color/color_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_today_outer"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="match_parent"
                            android:background="@color/home_cta_orange"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Lower Body"
                            android:textColor="@color/color_text_primary"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/lowerBodyCardImage"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:src="@drawable/squats"
                        android:scaleType="centerCrop"
                        android:contentDescription="Lower Body Focus Image"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="4dp">

                        <TextView
                            android:id="@+id/lowerBodyWorkout1Text"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_card_m3_elevated"
                            android:gravity="center_vertical"
                            android:paddingStart="16dp"
                            android:text="Back Squat"
                            android:textColor="@color/color_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <Button
        android:id="@+id/finishedWorkoutButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:minHeight="@dimen/gym_primary_button_height"
        android:text="@string/finished_workout"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="@color/color_on_primary"
        android:background="@drawable/bg_button_primary"
        android:fontFamily="sans-serif-medium"
        android:stateListAnimator="@animator/edit_button_elevation"
        android:elevation="2dp" />

    <include layout="@layout/layout_bottom_bar" />

</LinearLayout>
