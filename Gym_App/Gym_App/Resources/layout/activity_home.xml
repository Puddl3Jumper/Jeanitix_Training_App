<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/homeWelcomeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Welcome, [Name]!"
                android:textSize="38sp"
                android:lineSpacingExtra="1dp"
                android:fontFamily="sans-serif"
                android:textFontWeight="900"
                android:textColor="@color/color_primary"
                android:maxLines="2"
                android:breakStrategy="balanced"
                android:hyphenationFrequency="none"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="28sp"
                android:autoSizeMaxTextSize="42sp"
                android:autoSizeStepGranularity="1sp"
                android:layout_marginBottom="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_today_outer"
                android:elevation="4dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="24dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_today_workout"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif"
                    android:textFontWeight="900"
                    android:textColor="@color/md_theme_onSurface"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card_today_outer"
                        android:elevation="2dp"
                        android:padding="16dp"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_fitness_center"
                                android:tint="@color/color_text_primary"
                                android:contentDescription="@string/home_today_workout" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="8dp">

                                <TextView
                                    android:id="@+id/upperBodyLabelText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Upper Body"
                                    android:textColor="@color/md_theme_onSurfaceVariant"
                                    android:textSize="16sp"
                                    android:fontFamily="sans-serif"
                                    android:textFontWeight="600" />

                                <TextView
                                    android:id="@+id/upperBodyPlanText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:textColor="@color/color_primary"
                                    android:textSize="14sp"
                                    android:fontFamily="sans-serif"
                                    android:textFontWeight="400"
                                    android:text="Biceps/Triceps" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card_today_outer"
                        android:elevation="2dp"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_accessibility_new"
                                android:tint="@color/color_text_primary"
                                android:contentDescription="@string/home_today_workout" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="8dp">

                                <TextView
                                    android:id="@+id/lowerBodyLabelText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Lower Body"
                                    android:textColor="@color/md_theme_onSurfaceVariant"
                                    android:textSize="16sp"
                                    android:fontFamily="sans-serif"
                                    android:textFontWeight="600" />

                                <TextView
                                    android:id="@+id/lowerBodyPlanText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:textColor="@color/color_primary"
                                    android:textSize="14sp"
                                    android:fontFamily="sans-serif"
                                    android:textFontWeight="400"
                                    android:text="Abs" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/startWorkoutHomeButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/gym_primary_button_height"
                    android:text="@string/home_start_workout"
                    android:tooltipText="@string/home_start_workout_tooltip"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:textColor="@color/color_on_primary"
                    android:background="@drawable/bg_button_primary"
                    android:stateListAnimator="@animator/edit_button_elevation"
                    android:elevation="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="14dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_today_outer"
                android:elevation="2dp"
                android:padding="16dp"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="This week"
                    android:textColor="@color/color_text_primary"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/weeklyAvgValueText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/color_text_primary"
                        android:textStyle="bold"
                        android:textSize="44sp" />

                    <TextView
                        android:id="@+id/weeklyAvgLabelText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="mins per day (avg)"
                        android:textColor="@color/color_text_primary"
                        android:textSize="14sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/weeklyGoalSummaryText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="You hit your goal on 0 days, and trained a total of 0h"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:id="@+id/weeklyProgressChart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_today_outer"
                android:elevation="2dp"
                android:padding="16dp"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Insight"
                    android:textColor="@color/color_text_primary"
                    android:textStyle="bold"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/insightText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Start your first workout to unlock personalized insights."
                    android:textColor="@color/color_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_today_outer"
                android:elevation="2dp"
                android:padding="16dp"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="4"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:id="@+id/quickLogButton"
                            android:layout_width="@dimen/gym_quick_action_box_size"
                            android:layout_height="@dimen/gym_quick_action_box_size"
                            android:padding="@dimen/gym_quick_action_box_padding"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_quick_log_outline"
                            android:tint="@color/color_text_primary"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="Quick Log" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Quick Log"
                            android:textColor="@color/color_text_secondary"
                            android:textSize="12sp"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:id="@+id/historyButton"
                            android:layout_width="@dimen/gym_quick_action_box_size"
                            android:layout_height="@dimen/gym_quick_action_box_size"
                            android:padding="@dimen/gym_quick_action_box_padding"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_history_outline"
                            android:tint="@color/color_text_primary"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="History" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="History"
                            android:textColor="@color/color_text_secondary"
                            android:textSize="12sp"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:id="@+id/plansButton"
                            android:layout_width="@dimen/gym_quick_action_box_size"
                            android:layout_height="@dimen/gym_quick_action_box_size"
                            android:padding="@dimen/gym_quick_action_box_padding"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_plans_outline"
                            android:tint="@color/color_text_primary"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="Plans" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Plans"
                            android:textColor="@color/color_text_secondary"
                            android:textSize="12sp"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:id="@+id/bodyStatsButton"
                            android:layout_width="@dimen/gym_quick_action_box_size"
                            android:layout_height="@dimen/gym_quick_action_box_size"
                            android:padding="@dimen/gym_quick_action_box_padding"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_body_stats_outline"
                            android:tint="@color/color_text_primary"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="Body Stats" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Body Stats"
                            android:textColor="@color/color_text_secondary"
                            android:textSize="12sp"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_today_exercises"
                android:textColor="@color/color_primary"
                android:textSize="16sp"
                android:textStyle="normal"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/todayExercisesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_today_outer"
                android:elevation="2dp"
                android:padding="16dp"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/noRecordsIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="8dp"
                    android:src="@drawable/ic_empty_state_workout"
                    android:contentDescription="Workout empty state" />

                <TextView
                    android:id="@+id/noRecordsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Your fitness journey starts here! Tap 'Start Workout' to log your first session."
                    android:textColor="@color/color_text_primary"
                    android:gravity="center" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <include layout="@layout/layout_bottom_bar" />

</LinearLayout>
