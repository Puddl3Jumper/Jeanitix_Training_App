<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="32dp">

        <LinearLayout
            android:id="@+id/profileHeaderArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/profilePhoto"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_nav_profile"
                android:contentDescription="avatar"
                android:background="@drawable/bg_avatar_circle"
                android:clipToOutline="true"
                android:scaleType="centerInside"
                android:clickable="true"
                android:focusable="true"
                android:tint="@android:color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/profileGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Good morning,"
                    android:textSize="16sp"
                    android:textColor="@color/color_text_secondary"
                    android:singleLine="true"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/profileName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Your Name"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/profileBio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:text="Goal-focused strength training"
                    android:textSize="13sp"
                    android:textColor="@android:color/white" />
            </LinearLayout>
            
            <ImageButton
                android:id="@+id/editProfileButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@android:color/transparent"
                android:contentDescription="Edit profile"
                android:src="@drawable/ic_edit"
                android:tint="@android:color/white" />

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/weeklyProgressHeadline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Let's start your first workout today!"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white" />

                    <TextView
                        android:id="@+id/weeklyProgressText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="0% of your weekly goal is completed."
                        android:textSize="13sp"
                        android:textColor="@color/color_text_secondary" />

                    <ProgressBar
                        android:id="@+id/weeklyProgressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="10dp"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/bg_weekly_progress" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Key Metrics"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_primary"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/keyMetricsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/keyMetricsTabStats"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Stats"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:textColor="@color/color_on_primary"
                            android:background="@drawable/bg_log_tab_active" />

                        <TextView
                            android:id="@+id/keyMetricsTabPrs"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:gravity="center"
                            android:text="PRs"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:textColor="@color/color_text_secondary"
                            android:background="@drawable/bg_log_tab_inactive" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/keyMetricsStatsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:padding="8dp"
                                android:layout_marginEnd="6dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Weight"
                                    android:textSize="10sp"
                                    android:textColor="@android:color/white"
                                    android:includeFontPadding="false" />

                                <TextView
                                    android:id="@+id/statWeightValue"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="--"
                                    android:textStyle="bold"
                                    android:textSize="20sp"
                                    android:textColor="@android:color/white"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:includeFontPadding="false" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:padding="8dp"
                                android:layout_marginStart="6dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Height"
                                    android:textSize="10sp"
                                    android:textColor="@android:color/white"
                                    android:includeFontPadding="false" />

                                <TextView
                                    android:id="@+id/statHeightValue"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="--"
                                    android:textStyle="bold"
                                    android:textSize="20sp"
                                    android:textColor="@android:color/white"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:includeFontPadding="false" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:padding="8dp"
                                android:layout_marginEnd="6dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Age"
                                    android:textSize="10sp"
                                    android:textColor="@android:color/white"
                                    android:includeFontPadding="false" />

                                <TextView
                                    android:id="@+id/statAgeValue"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="--"
                                    android:textStyle="bold"
                                    android:textSize="20sp"
                                    android:textColor="@android:color/white"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:includeFontPadding="false" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:padding="8dp"
                                android:layout_marginStart="6dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Body Fat"
                                    android:textSize="10sp"
                                    android:textColor="@android:color/white"
                                    android:includeFontPadding="false" />

                                <TextView
                                    android:id="@+id/statBodyFatValue"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="--"
                                    android:textStyle="bold"
                                    android:textSize="20sp"
                                    android:textColor="@android:color/white"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:includeFontPadding="false" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/keyMetricsPrsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/prSquatValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Squat 1RM: --"
                            android:textSize="12sp"
                            android:textColor="@android:color/white"
                            android:layout_marginBottom="2dp"
                            android:singleLine="true"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/prBenchValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Bench 1RM: --"
                            android:textSize="12sp"
                            android:textColor="@android:color/white"
                            android:layout_marginBottom="2dp"
                            android:singleLine="true"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/prDeadliftValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Deadlift 1RM: --"
                            android:textSize="12sp"
                            android:textColor="@android:color/white"
                            android:layout_marginBottom="2dp"
                            android:singleLine="true"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/prOverheadValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Overhead Press (optional): --"
                            android:textSize="12sp"
                            android:textColor="@android:color/white"
                            android:singleLine="true"
                            android:ellipsize="end" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Training Summary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_primary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/summaryWeekValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Workouts this week: 0"
                        android:textSize="14sp"
                        android:textColor="@android:color/white"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/summaryTotalValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Total workouts: 0"
                        android:textSize="14sp"
                        android:textColor="@android:color/white"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/summaryStreakValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Current streak: 0 days"
                        android:textSize="14sp"
                        android:textColor="@android:color/white"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/summaryVolumeValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Volume lifted (optional): 0 kg"
                        android:textSize="14sp"
                        android:textColor="@android:color/white" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Quick Actions"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_primary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <Button
                        android:id="@+id/quickStartWorkoutButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Start Workout"
                        android:textAllCaps="false"
                        android:drawableStart="@android:drawable/ic_media_play"
                        android:drawablePadding="8dp"
                        android:background="@drawable/bg_button_primary"
                        android:textColor="@color/color_on_primary"
                        android:layout_marginBottom="8dp" />

                    <Button
                        android:id="@+id/quickLogWeightButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Log Weight"
                        android:textAllCaps="false"
                        android:drawableStart="@android:drawable/ic_menu_edit"
                        android:drawablePadding="8dp"
                        android:background="@drawable/bg_button_primary"
                        android:textColor="@color/color_on_primary"
                        android:layout_marginBottom="8dp" />

                    <Button
                        android:id="@+id/quickViewHistoryButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="View Full History"
                        android:textAllCaps="false"
                        android:drawableStart="@android:drawable/ic_menu_recent_history"
                        android:drawablePadding="8dp"
                        android:background="@drawable/bg_button_primary"
                        android:textColor="@color/color_on_primary" />

                    <Button
                        android:id="@+id/quickViewProgressButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="View Progress"
                        android:textAllCaps="false"
                        android:drawableStart="@android:drawable/ic_menu_sort_by_size"
                        android:drawablePadding="8dp"
                        android:background="@drawable/bg_button_primary"
                        android:textColor="@color/color_on_primary"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Account"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_primary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="16dp">

                    <Button
                        android:id="@+id/settingsButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Settings"
                        android:textAllCaps="false"
                        android:drawableStart="@android:drawable/ic_menu_manage"
                        android:drawablePadding="8dp"
                        android:background="@drawable/bg_button_primary"
                        android:textColor="@color/color_on_primary"
                        android:layout_marginBottom="8dp" />

                    <Button
                        android:id="@+id/logoutButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Logout"
                        android:textAllCaps="false"
                        android:drawableStart="@android:drawable/ic_lock_power_off"
                        android:drawablePadding="8dp"
                        android:background="@drawable/bg_button_primary"
                        android:textColor="@color/color_on_primary" />
                </LinearLayout>

            </LinearLayout>

        </ScrollView>
    </LinearLayout>

    <include layout="@layout/layout_bottom_bar" />

</LinearLayout>
