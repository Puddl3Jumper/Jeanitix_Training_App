<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen"
    android:fitsSystemWindows="true"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/camera_loop_title"
        android:textColor="@color/home_cta_orange"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/cameraLoopExerciseText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/camera_loop_exercise_default"
        android:textColor="@color/color_text_secondary"
        android:textSize="16sp"
        android:layout_marginBottom="12dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card_today_outer"
        android:padding="2dp">

        <SurfaceView
            android:id="@+id/cameraLoopPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_card_today_outer"
        android:padding="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/camera_loop_count_label"
            android:textColor="@color/color_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/cameraLoopCountText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/color_primary"
            android:textSize="56sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cameraLoopStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/camera_loop_status_ready"
            android:textAlignment="center"
            android:textColor="@color/color_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <Button
        android:id="@+id/cameraLoopStartStopButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/gym_primary_button_height"
        android:text="@string/camera_loop_start"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="@color/color_on_primary"
        android:background="@drawable/bg_button_primary"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/cameraLoopSaveButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/gym_primary_button_height"
        android:text="@string/camera_loop_save"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="@color/color_on_primary"
        android:background="@drawable/bg_button_success"
        android:fontFamily="sans-serif-medium" />

</LinearLayout>
