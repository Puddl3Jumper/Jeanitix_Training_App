<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Log"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/color_primary"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">
            <TextView
                android:id="@+id/dayTab"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/gym_primary_button_height"
                android:minWidth="48dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:text="Day"
                android:textStyle="bold"
                android:textColor="@color/color_on_primary"
                android:background="@drawable/bg_button_primary"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/weekTab"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/gym_primary_button_height"
                android:minWidth="48dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:text="Week"
                android:textColor="@color/color_on_primary"
                android:background="@drawable/bg_button_primary"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/monthTab"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/gym_primary_button_height"
                android:minWidth="48dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:text="Month"
                android:textColor="@color/color_on_primary"
                android:background="@drawable/bg_button_primary"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/historyRangeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Feb 15, 2026"
            android:textSize="13sp"
            android:textColor="@color/color_text_secondary"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <ScrollView
            android:id="@+id/historyScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingBottom="96dp">

            <LinearLayout
                android:id="@+id/historyContainer"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </ScrollView>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/quickAddFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="@string/history_quick_add"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="@color/color_primary"
        app:tint="@color/color_on_primary" />

    <include layout="@layout/layout_bottom_bar" />

</LinearLayout>
