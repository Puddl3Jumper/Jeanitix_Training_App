<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/md_theme_surfaceVariant"
            app:title="Settings"
            app:titleTextColor="@color/color_text_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/weightUnitHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Weight Unit (KG)"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/color_primary" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Weekly Goal"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/color_primary" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/weeklyGoal3Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="3"
                    android:textAllCaps="false"
                    android:textColor="@color/color_on_primary"
                    android:background="@drawable/bg_button_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/weeklyGoal4Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="4"
                    android:textAllCaps="false"
                    android:textColor="@color/color_on_primary"
                    android:background="@drawable/bg_button_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/weeklyGoal5Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="5"
                    android:textAllCaps="false"
                    android:textColor="@color/color_on_primary"
                    android:background="@drawable/bg_button_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/weeklyGoal6Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="6"
                    android:textAllCaps="false"
                    android:textColor="@color/color_on_primary"
                    android:background="@drawable/bg_button_primary" />

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/unitKgButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="KG"
                    android:textAllCaps="false"
                    android:textColor="@color/color_on_primary"
                    android:background="@drawable/bg_button_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/unitLbButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="LB"
                    android:textAllCaps="false"
                    android:textColor="@color/color_on_primary"
                    android:background="@drawable/bg_button_primary" />

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Appearance"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/color_primary" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/themeLightButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Light"
                    android:textAllCaps="false"
                    android:textColor="@color/color_on_primary"
                    android:background="@drawable/bg_button_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/themeDarkButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="Dark"
                    android:textAllCaps="false"
                    android:textColor="@color/color_on_primary"
                    android:background="@drawable/bg_button_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/themeSystemButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="System"
                    android:textAllCaps="false"
                    android:textColor="@color/color_on_primary"
                    android:background="@drawable/bg_button_primary" />

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Data Export"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/color_primary" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/exportCsvButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Export CSV"
                android:textAllCaps="false"
                android:textColor="@color/color_on_primary"
                android:background="@drawable/bg_button_primary"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/appVersionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/settings_release_placeholder"
            android:textColor="@color/color_text_secondary"
            android:textSize="13sp" />

    </LinearLayout>

    <include layout="@layout/layout_bottom_bar" />

</LinearLayout>
