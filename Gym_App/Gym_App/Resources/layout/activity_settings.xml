<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="96dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp">

        <com.google.android.material.appbar.MaterialToolbar
            style="@style/Widget.GymApp.TopAppBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Weekly Goal"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/color_primary" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_today_outer"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/weeklyGoal3Button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/gym_primary_button_height"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="3"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_secondary"
                    android:background="@drawable/bg_log_tab_inactive" />

                <TextView
                    android:id="@+id/weeklyGoal4Button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/gym_primary_button_height"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="4"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_secondary"
                    android:background="@drawable/bg_log_tab_inactive" />

                <TextView
                    android:id="@+id/weeklyGoal5Button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/gym_primary_button_height"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="5"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_secondary"
                    android:background="@drawable/bg_log_tab_inactive" />

                <TextView
                    android:id="@+id/weeklyGoal6Button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/gym_primary_button_height"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="6"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_secondary"
                    android:background="@drawable/bg_log_tab_inactive" />

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Typography"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/color_primary" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_today_outer"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/fontSansButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/gym_primary_button_height"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="Sans"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_secondary"
                    android:background="@drawable/bg_log_tab_inactive" />

                <TextView
                    android:id="@+id/fontSerifButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/gym_primary_button_height"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="Serif"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_secondary"
                    android:background="@drawable/bg_log_tab_inactive" />

                <TextView
                    android:id="@+id/fontMonoButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/gym_primary_button_height"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="Mono"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_secondary"
                    android:background="@drawable/bg_log_tab_inactive" />

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Appearance"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/color_primary" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_today_outer"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/themeLightButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/gym_primary_button_height"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="Light"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_secondary"
                    android:background="@drawable/bg_log_tab_inactive" />

                <TextView
                    android:id="@+id/themeDarkButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/gym_primary_button_height"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="Dark"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_secondary"
                    android:background="@drawable/bg_log_tab_inactive" />

                <TextView
                    android:id="@+id/themeSystemButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/gym_primary_button_height"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="System"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_secondary"
                    android:background="@drawable/bg_log_tab_inactive" />

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Data Export"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/color_primary" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_today_outer"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/exportCsvButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Export CSV"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@color/color_on_primary"
                android:background="@drawable/bg_button_primary"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@animator/edit_button_elevation"
                android:elevation="2dp"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reminder"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/color_primary" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_today_outer"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <!-- Daily Reminder title + switch -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Daily Reminder"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Plays a voice reminder with today's workout rotation"
                        android:textSize="13sp"
                        android:textColor="@color/color_text_secondary" />

                </LinearLayout>

                <Switch
                    android:id="@+id/reminderEnabledSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" />

            </LinearLayout>

            <!-- Preview button -->
            <Button
                android:id="@+id/reminderPreviewButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="Preview"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@color/color_primary"
                android:background="@drawable/bg_button_skip"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:layout_marginTop="14dp" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/color_text_secondary"
                android:alpha="0.2"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp" />

            <!-- Reminder Time row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Reminder Time"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Tap to change the daily alarm time"
                        android:textSize="12sp"
                        android:textColor="@color/color_text_secondary" />

                </LinearLayout>

                <TextView
                    android:id="@+id/reminderTimeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="07:00"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginStart="12dp" />

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/color_text_secondary"
                android:alpha="0.2"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp" />

            <!-- Reminder Days label -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reminder Days"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_marginBottom="12dp" />

            <!-- Day circle buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center">
                    <TextView android:id="@+id/reminderDayMon" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:gravity="center" android:clickable="true" android:focusable="true" android:text="M" android:textStyle="bold" android:textSize="13sp" android:textColor="@android:color/white" android:background="@drawable/bg_day_circle_inactive" />
                </FrameLayout>

                <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center">
                    <TextView android:id="@+id/reminderDayTue" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:gravity="center" android:clickable="true" android:focusable="true" android:text="T" android:textStyle="bold" android:textSize="13sp" android:textColor="@android:color/white" android:background="@drawable/bg_day_circle_inactive" />
                </FrameLayout>

                <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center">
                    <TextView android:id="@+id/reminderDayWed" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:gravity="center" android:clickable="true" android:focusable="true" android:text="W" android:textStyle="bold" android:textSize="13sp" android:textColor="@android:color/white" android:background="@drawable/bg_day_circle_inactive" />
                </FrameLayout>

                <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center">
                    <TextView android:id="@+id/reminderDayThu" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:gravity="center" android:clickable="true" android:focusable="true" android:text="T" android:textStyle="bold" android:textSize="13sp" android:textColor="@android:color/white" android:background="@drawable/bg_day_circle_inactive" />
                </FrameLayout>

                <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center">
                    <TextView android:id="@+id/reminderDayFri" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:gravity="center" android:clickable="true" android:focusable="true" android:text="F" android:textStyle="bold" android:textSize="13sp" android:textColor="@android:color/white" android:background="@drawable/bg_day_circle_inactive" />
                </FrameLayout>

                <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center">
                    <TextView android:id="@+id/reminderDaySat" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:gravity="center" android:clickable="true" android:focusable="true" android:text="S" android:textStyle="bold" android:textSize="13sp" android:textColor="@android:color/white" android:background="@drawable/bg_day_circle_inactive" />
                </FrameLayout>

                <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center">
                    <TextView android:id="@+id/reminderDaySun" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:gravity="center" android:clickable="true" android:focusable="true" android:text="S" android:textStyle="bold" android:textSize="13sp" android:textColor="@android:color/white" android:background="@drawable/bg_day_circle_inactive" />
                </FrameLayout>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Account"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/color_primary" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_today_outer"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/logoutButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Logout"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@color/color_on_primary"
                android:background="@drawable/bg_button_primary"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@animator/edit_button_elevation"
                android:elevation="2dp" />
        </LinearLayout>

            <TextView
                android:id="@+id/appVersionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/settings_release_placeholder"
                android:textColor="@color/color_text_secondary"
                android:textSize="13sp" />

        </LinearLayout>

    </ScrollView>

    <include layout="@layout/layout_bottom_bar" />

</LinearLayout>
