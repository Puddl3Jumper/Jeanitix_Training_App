<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp">

        <com.google.android.material.appbar.MaterialToolbar
            style="@style/Widget.GymApp.TopAppBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:title="Settings" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_today_outer"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Weekly Goal"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/color_primary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/weeklyGoal3Button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/gym_primary_button_height"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="3"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_secondary"
                    android:background="@drawable/bg_log_tab_inactive" />

                <TextView
                    android:id="@+id/weeklyGoal4Button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/gym_primary_button_height"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="4"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_secondary"
                    android:background="@drawable/bg_log_tab_inactive" />

                <TextView
                    android:id="@+id/weeklyGoal5Button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/gym_primary_button_height"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="5"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_secondary"
                    android:background="@drawable/bg_log_tab_inactive" />

                <TextView
                    android:id="@+id/weeklyGoal6Button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/gym_primary_button_height"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="6"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_secondary"
                    android:background="@drawable/bg_log_tab_inactive" />

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Typography"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/color_primary" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_today_outer"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/fontSansButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/gym_primary_button_height"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="Sans"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_secondary"
                    android:background="@drawable/bg_log_tab_inactive" />

                <TextView
                    android:id="@+id/fontSerifButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/gym_primary_button_height"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="Serif"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_secondary"
                    android:background="@drawable/bg_log_tab_inactive" />

                <TextView
                    android:id="@+id/fontMonoButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/gym_primary_button_height"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="Mono"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_secondary"
                    android:background="@drawable/bg_log_tab_inactive" />

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Appearance"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/color_primary" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_today_outer"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/themeLightButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/gym_primary_button_height"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="Light"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_secondary"
                    android:background="@drawable/bg_log_tab_inactive" />

                <TextView
                    android:id="@+id/themeDarkButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/gym_primary_button_height"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="Dark"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_secondary"
                    android:background="@drawable/bg_log_tab_inactive" />

                <TextView
                    android:id="@+id/themeSystemButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/gym_primary_button_height"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="System"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_secondary"
                    android:background="@drawable/bg_log_tab_inactive" />

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Data Export"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/color_primary" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_today_outer"
            android:padding="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/exportCsvButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Export CSV"
                android:textAllCaps="false"
                android:textColor="@color/color_on_primary"
                android:background="@drawable/bg_button_primary"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Account"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/color_primary" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_today_outer"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logoutButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Logout"
                android:textAllCaps="false"
                android:textColor="@color/color_on_primary"
                android:background="@drawable/bg_button_primary" />
        </LinearLayout>

        <TextView
            android:id="@+id/appVersionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/settings_release_placeholder"
            android:textColor="@color/color_text_secondary"
            android:textSize="13sp" />

    </LinearLayout>

    <include layout="@layout/layout_bottom_bar" />

</LinearLayout>
