<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:backgroundTint="@color/md_theme_surfaceVariant"
            app:title="Progress"
            app:titleTextColor="@color/color_text_primary" />

        <Spinner
            android:id="@+id/exerciseSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Summary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/color_primary"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/prValueText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PR: --"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/lastValueText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Last: --"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Progress Chart"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/color_primary"
            android:layout_marginBottom="8dp" />

        <FrameLayout
            android:id="@+id/chartContainer"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/progressHintText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select an exercise to view weight progress over time"
            android:textColor="@color/color_text_secondary"
            android:textSize="13sp" />

    </LinearLayout>

    <include layout="@layout/layout_bottom_bar" />

</LinearLayout>
